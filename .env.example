# Copy this file to ".env" and paste your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Payments (use TEST / SANDBOX keys first). Leave empty to stay in demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Your website's public address once online, e.g. https://sehatdesk.com
PUBLIC_URL=
