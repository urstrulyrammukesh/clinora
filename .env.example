# Copy this file to ".env" and paste your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Payments (use TEST / SANDBOX keys first). Leave empty to stay in demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Your website's public address once online, e.g. https://sehatdesk.com
PUBLIC_URL=

# Webhooks (confirm payments even if the patient closes the page)
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=

# On the real website set APP_ENV=production: demo payments are switched off,
# and only fixed prices are charged (base currency + LOCAL_PRICES in server.py).
APP_ENV=
# Set to 1 only if you connect a live exchange-rate source and want converted prices.
ALLOW_FX_PRICES=

# Log in with Google, Facebook and X. Each button switches on when its keys are here.
# Step-by-step: docs/social-login.md   (needs your real https address in PUBLIC_URL)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Email for "Forgot password" links (any SMTP service). Step-by-step: docs/email-setup.md
# Without these, on your own computer the reset link is printed in the Terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Backups: automatic, into data/backups (every 24 h, newest 14 kept). Step-by-step: docs/backups.md
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
BACKUP_VIDEOS=0
# Optional cloud copy (Cloudflare R2, Backblaze B2, AWS S3...), so a lost disk doesn't lose your data
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=

# Live site only: a long secret you choose. Needed once to create the clinic admin account.
ADMIN_SETUP_CODE=
